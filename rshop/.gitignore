# WordPress тема rshop - .gitignore

# Временные и сгенерированные файлы
/Components/PremiumComponents/
npm-debug.log
yarn-error.log
*.log
*.tmp
*.temp
*.cache

# Зависимости и библиотеки
/node_modules/
/vendor/
/bower_components/
/jspm_packages/
composer.phar

# Локальные конфигурации и среды
.env
.env.*
!.env.example
.htaccess
wp-config.php

# Скомпилированные ресурсы и кэши
# Комментарий: Временно включаем /dist в репозиторий
/dist/
.cache/
.sass-cache/
docs/styles/**/*.css.map
# build/
# НЕ игнорировать build директорию в checkout-wc
!checkout-wc/default/build/

# Vite специфичные файлы
.vite/

# Файлы IDE и редакторов
